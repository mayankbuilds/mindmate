# Client Environment Variables (React Vite)

# Local development fallback:
VITE_API_URL=http://localhost:5000/api

# Production options:
# 1) If client is hosted on Render / Vercel pointing to the deployed Node backend:
# VITE_API_URL=https://your-mindmate-backend.onrender.com/api
# (Note: You can specify either https://your-backend.onrender.com or with /api; both work)
#
# 2) If client is served from the same domain as the Express server (unified):
# VITE_API_URL=/api
