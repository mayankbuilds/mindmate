# Client Environment Variables (React Vite)

# Local development:
VITE_API_BASE_URL=http://localhost:5000/api

# Production options:
# 1) If client is hosted on Vercel/Netlify and server is on Render:
# VITE_API_BASE_URL=https://your-mindmate-api.onrender.com/api
#
# 2) If client is served from the same domain as the Express server:
# VITE_API_BASE_URL=/api
