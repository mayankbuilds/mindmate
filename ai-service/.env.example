# AI Service Environment Variables (FastAPI microservice)
PORT=8000

# Primary Provider: Google Gemini API (Free/Budget tier available at https://aistudio.google.com/)
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite

# Optional Secondary Provider: Groq / OpenAI-compatible provider
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_your_groq_api_key_here
# AI_MODEL=llama-3.1-8b-instant

# Security: comma-separated origins allowed to call the AI service
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://mindmate-wellness.onrender.com
