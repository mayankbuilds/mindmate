# Server Environment Variables (Express API Gateway)
PORT=5000
NODE_ENV=development

# Database: MongoDB connection string (local or MongoDB Atlas in cloud)
MONGO_URI=mongodb://localhost:27017/mindmate

# Authentication: JWT secret key & expiration
JWT_SECRET=super_mindmate_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Microservices: URL of the Python FastAPI service.
# REQUIRED for Flow A (ML questionnaire stress assessment). If unreachable, the assessment route
# returns HTTP 503 rather than inventing fake predictions.
FASTAPI_SERVICE_URL=http://localhost:8000
# Timeout for upstream AI requests in ms (default 20000 allows for Render free tier cold starts)
FASTAPI_TIMEOUT_MS=20000

# Security: Comma-separated CORS allowed origins in production (e.g., https://mindmate.vercel.app)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Application Timezone: determines midnight rollover for daily wellness check-in (e.g., UTC, Asia/Kolkata)
APP_TIMEZONE=UTC

# Emergency SOS Alert: SMTP email configuration (Gmail App Password or SendGrid/Postmark)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="MindMate Support <alerts@mindmate.app>"

# Deployment: set to true if running a single unified instance where Express serves React dist
SERVE_STATIC=false
