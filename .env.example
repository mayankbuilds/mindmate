# ==============================================================================
# MindMate — Master Environment Variables Checklist & Deployment Guide
# ==============================================================================
# This file centralizes all environment variables across all services.
# When deploying online (e.g., Render, Railway, Vercel, VPS), use the variables
# relevant to the service you are configuring.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS BACKEND (server/.env) — REQUIRED FOR LIVE API
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production

# MongoDB connection string (Get a free cluster from https://cloud.mongodb.com/)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/mindmate?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/mindmate

# Secret used to sign JSON Web Tokens (any long secure random string)
JWT_SECRET=mindmate_super_secret_jwt_key_2026_secure
JWT_EXPIRES_IN=7d

# Google Gemini API Key for CalmFlow Wellness Chatbot (FREE at https://aistudio.google.com/)
# When added, the chatbot uses Gemini 1.5 Flash.
# If omitted or unavailable, the chatbot automatically uses the safe rule-based fallback.
GEMINI_API_KEY=your_gemini_api_key_here

# Microservices: URL of the Python FastAPI service (optional; if omitted, Node uses Gemini/fallback directly)
FASTAPI_SERVICE_URL=http://localhost:8000

# Emergency SOS Email Alerts (Optional - Gmail App Password or SMTP provider)
# In Gmail: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="MindMate Support <alerts@mindmate.app>"

# Set to true if deploying a single unified service where Node serves built React frontend
SERVE_STATIC=false

# ------------------------------------------------------------------------------
# 2. PYTHON AI SERVICE (ai-service/.env) — OPTIONAL IF NODE CALLS GEMINI DIRECTLY
# ------------------------------------------------------------------------------
PORT=8000
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=qwen-2.5-32b
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. REACT FRONTEND (client/.env) — CONFIGURED AT BUILD TIME
# ------------------------------------------------------------------------------
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api

# For Vercel/Netlify pointing to deployed Node server:
# VITE_API_BASE_URL=https://mindmate-backend.onrender.com/api

# For single unified deployment where Node serves the frontend:
# VITE_API_BASE_URL=/api
